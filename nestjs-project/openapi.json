    "/videos/{id}/stream": {
      "get": {
        "description": "Returns a short-lived presigned URL to the processed faststart MP4; storage serves HTTP Range for seeking. Open by unique URL in Phase 03. `:id` is the video public_id.",
        "operationId": "VideosController_stream",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
