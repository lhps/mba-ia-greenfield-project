    },
    "/videos/{id}/download": {
      "get": {
        "description": "Returns a short-lived presigned URL to the processed MP4 with an attachment Content-Disposition (owner only). `:id` is the video public_id.",
        "operationId": "VideosController_download",
        "parameters": [
          {
            "name": "id",
