          "409": {
            "description": "Video is not ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Get a download URL",
        "tags": [
          "videos"
        ]
      }
    }
  },
  "info": {
    "title": "StreamTube API",
    "description": "API REST do StreamTube",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {}
      },
      "ResendConfirmationDto": {
        "type": "object",
        "properties": {}
      },
      "LoginDto": {
        "type": "object",
        "properties": {}
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {}
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {}
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {}
      },
      "CreateVideoUploadDto": {
        "type": "object",
        "properties": {}
      },
      "VideoUploadStartedDto": {
        "type": "object",
        "properties": {
          "public_id": {
            "type": "string",
            "example": "dQw4w9WgXcQ",
            "minLength": 11,
            "maxLength": 11
          },
          "processing_status": {
            "type": "string",
            "enum": [
              "uploading"
            ]
          },
          "publication_status": {
            "type": "string",
            "enum": [
              "draft"
            ]
          },
          "part_size": {
            "type": "number",
            "example": 67108864,
            "description": "Bytes per part (last part may be smaller)"
          },
          "part_count": {
            "type": "number",
            "example": 3
          }
        },
        "required": [
          "public_id",
          "processing_status",
          "publication_status",
          "part_size",
          "part_count"
        ]
      },
      "RequestUploadPartsDto": {
        "type": "object",
        "properties": {}
      },
      "PresignedPartDto": {
        "type": "object",
        "properties": {
          "part_number": {
            "type": "number",
            "example": 1
          },
          "url": {
            "type": "string",
            "description": "Presigned UploadPart URL — PUT the raw part bytes; read the ETag response header"
          }
        },
        "required": [
          "part_number",
          "url"
        ]
      },
      "UploadPartsPresignedDto": {
        "type": "object",
        "properties": {
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PresignedPartDto"
            }
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "parts",
          "expires_at"
        ]
      },
      "CompleteUploadDto": {
        "type": "object",
        "properties": {}
      },
      "UploadCompletedDto": {
        "type": "object",
        "properties": {
          "public_id": {
            "type": "string",
            "example": "dQw4w9WgXcQ"
          },
          "processing_status": {
            "type": "string",
            "enum": [
              "processing"
            ]
          }
        },
        "required": [
          "public_id",
          "processing_status"
        ]
      },
      "VideoResponseDto": {
        "type": "object",
        "properties": {
          "public_id": {
            "type": "string",
            "example": "dQw4w9WgXcQ"
          },
          "file_name": {
            "type": "string",
            "example": "clip.mp4"
          },
          "processing_status": {
            "type": "string",
            "enum": [
              "uploading",
              "processing",
              "ready",
              "failed"
            ]
          },
          "publication_status": {
            "type": "string",
            "enum": [
              "draft"
            ]
          },
          "duration_seconds": {
            "type": "number",
            "nullable": true,
            "example": 2.04
          },
          "width": {
            "type": "number",
            "nullable": true,
            "example": 1920
          },
          "height": {
            "type": "number",
            "nullable": true,
            "example": 1080
          },
          "thumbnail_url": {
            "type": "string",
            "nullable": true,
            "description": "Presigned GET of the thumbnail; null until processed"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "public_id",
